# Environment variables for Requirements Extraction System
# Copy this file to .env and fill in your actual API keys

# ============================================
# OpenRouter Configuration (REQUIRED)
# ============================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Database Configuration (OPTIONAL)
# ============================================
# Database URL for PostgreSQL
# Default: postgresql://requirements_user:requirements_pass@localhost:5433/requirements_db
# For Docker Compose: postgresql://requirements_user:requirements_pass@postgres:5432/requirements_db
DATABASE_URL=postgresql://requirements_user:requirements_pass@localhost:5433/requirements_db

# ============================================
# Logging Configuration (OPTIONAL)
# ============================================
# Logging level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO