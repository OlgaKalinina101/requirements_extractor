# Environment variables for Requirements Extraction System
# Copy this file to .env and fill in your actual API keys

# ============================================
# OpenRouter Configuration (REQUIRED)
# ============================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Database Configuration (OPTIONAL)
# ============================================
# Database URL for PostgreSQL
# Default (Docker Compose): postgresql://requirements_user:requirements_pass@localhost:5433/requirements_db
# For Docker Compose internal: postgresql://requirements_user:requirements_pass@postgres:5432/requirements_db
DATABASE_URL=postgresql://requirements_user:requirements_pass@localhost:5433/requirements_db

# ============================================
# Auth Configuration (OPTIONAL)
# ============================================
# Secret key for JWT signing (change in production!)
SECRET_KEY=your-secret-key-change-in-production
# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
# First admin user — created automatically on first startup if DB has no users
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Администратор

# ============================================
# CORS Configuration (OPTIONAL)
# ============================================
# Comma-separated list of allowed origins (required when allow_credentials=True)
# Default: Vite dev (5173) and nginx (8080)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://yourdomain.com

# ============================================
# Logging Configuration (OPTIONAL)
# ============================================
# Logging level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO